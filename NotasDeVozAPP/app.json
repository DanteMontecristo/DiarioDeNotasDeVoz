{
  "expo": {
    "name": "Diario de notas de voz",
    "slug": "diario-de-notas-de-voz",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "notasdevoz",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.notasdevoz.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "La app usa el micrófono únicamente para grabar tus notas de voz cuando tú lo pides."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación únicamente para guardar la ciudad donde grabas una nota, si activas esa opción."
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4dbb7bcd-576d-442a-9a09-6e9f8cc8271d"
      }
    },
    "owner": "dantemontecristo"
  }
}
