{
  "name": "notas-de-voz-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/services/**/*.{ts,tsx}",
      "src/repositories/**/*.{ts,tsx}",
      "src/utils/**/*.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    }
  }
}
