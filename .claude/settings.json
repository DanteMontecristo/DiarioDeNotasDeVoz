{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "additionalDirectories": [],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Edit(**/.env*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*firebase-adminsdk*.json)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(./.claude/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel env pull*)",
      "PowerShell(sudo *)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget.exe *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(vercel env pull*)",
      "PowerShell(npx vercel env pull*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm uninstall *)",
      "Bash(npm update*)",
      "Bash(npx expo install*)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(eas *)",
      "Bash(npx eas*)",
      "Bash(npx eas-cli*)",
      "PowerShell(git push*)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update*)",
      "PowerShell(npx expo install*)",
      "PowerShell(yarn add *)",
      "PowerShell(pnpm add *)",
      "PowerShell(vercel*)",
      "PowerShell(npx vercel*)",
      "PowerShell(eas *)",
      "PowerShell(npx eas*)",
      "PowerShell(npx eas-cli*)",
      "WebFetch"
    ]
  }
}
