# Plantilla de variables de entorno de la API. TODOS los valores son FALSOS.
# Las claves reales viven únicamente en Vercel; en desarrollo use el emulador de Firebase.
# Este archivo se llama env.example (sin punto) para que la IA sí pueda leerlo.

FIREBASE_PROJECT_ID=demo-notas-de-voz
FIREBASE_CLIENT_EMAIL=cuenta-falsa@demo-notas-de-voz.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="CLAVE-FALSA-NO-ES-UN-SECRETO"
FIREBASE_WEB_API_KEY=CLAVE-FALSA-NO-ES-UN-SECRETO
